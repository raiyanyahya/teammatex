# ─── Application ─────────────────────────────────────────────
TEAMMATEX_NAME=Dev
TEAMMATEX_PERSONA=helpful_senior_dev
TEAMMATEX_SECRET_KEY=change-me-to-a-random-string

# ─── Database ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=teammatex
POSTGRES_USER=teammatex
POSTGRES_PASSWORD=change-me-postgres

TEAMMATEX_NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

REDIS_URL=redis://redis:6379/0

# ─── LLM Providers ──────────────────────────────────────────
# At least one provider must be configured.
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek (cost-effective default)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama (local — no API key needed)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# ─── Embeddings ─────────────────────────────────────────────
# Local embeddings (default, zero cost) — fastembed/ONNX, no PyTorch.
EMBEDDING_PROVIDER=local
# 384-dim, best local retrieval in our bake-off. Legacy value all-MiniLM-L6-v2
# still works (auto-mapped to fastembed). Set EMBEDDING_PROVIDER=openai for cloud.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Integrations ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# ─── Observability ──────────────────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin
# Token required to read /metrics. Leave empty to keep the endpoint disabled.
# To enable scraping, set a strong value here AND in docker/prometheus.yml.
TEAMMATEX_METRICS_TOKEN=
